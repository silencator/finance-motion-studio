{
  "name": "finance-motion-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Monochrome narrative finance motion graphics, narration-driven, built on Remotion",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "analyze": "node scripts/analyze-audio.mjs",
    "transcribe": "python3 scripts/transcribe.py",
    "sfx": "python3 scripts/make-sfx.py",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/stills.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/media-utils": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/three": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "gsap": "3.15.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.545",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
}
